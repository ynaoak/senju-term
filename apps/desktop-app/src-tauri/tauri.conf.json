{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Senju Term",
  "version": "0.1.0",
  "identifier": "dev.senju.term",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Senju Term",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzRkEyQkQyRTc1OTQ0OEMKUldTTVJGbm4waXY2UTVRYUNxM0xjQjRLUzltN0dVVkNEcnVOOGJlVFVRTjRicnVhL3Rtb21BR1IK",
      "endpoints": [
        "https://github.com/ynaoak/senju-term/releases/latest/download/latest.json"
      ]
    }
  }
}
